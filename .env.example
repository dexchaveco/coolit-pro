# Copy this to .env.local for local development, and set the same values
# as environment variables wherever you deploy.

# Long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
COOLIT_SESSION_SECRET=change-me-to-a-long-random-string

# Shared secret your phone provider's webhook must send back to prove the
# request is really from them. Any long random string works.
CALL_WEBHOOK_SECRET=change-me-too

# Where the SQLite database file lives. Point this at a persistent
# disk/volume in production. Defaults to ./data/coolit.db if unset.
DB_PATH=./data/coolit.db

# Public URL of your deployed app. Used to show the webhook URL on the
# Settings page, AND as the QuickBooks OAuth redirect target — must be set
# correctly (with https://) once you connect QuickBooks, or the "Connect"
# button will send you back to the wrong place.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- QuickBooks Online integration (optional — only needed once you connect QuickBooks) ---
# From an Intuit Developer app (https://developer.intuit.com) under
# "Keys & OAuth". Use the Development keys while testing (sandbox company),
# Production keys once you're ready to sync real invoices.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" while testing against a fake QuickBooks company, "production"
# once pointed at your real Cool It With Rick QuickBooks.
QBO_ENVIRONMENT=sandbox
